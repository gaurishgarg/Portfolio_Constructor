# Copy this file to ".env" (git ignores it) and fill it in. Never commit ".env".

# Any long random string; used to sign Flask sessions.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional: a GitHub personal access token (no scopes needed for public repositories).
# Only used by the "Sync from GitHub" button of the Code page, to lift GitHub's 60-requests-an-hour limit.
# GITHUB_TOKEN=
